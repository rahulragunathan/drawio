# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local dev environment (see CONTRIBUTING.md)
# No trailing slash: .venv is a symlink to ~/Python-Envs/<name>, not a
# directory, and a "dir/" pattern would not match it.
.venv

# macOS
.DS_Store

# Build/scratch artifacts — diagrams generated while working on the skill
*.drawio
*.png
!examples/*.drawio

# renders/ is the exception: regenerated at the end of each phase and
# reviewed for sign-off, so the repo records what each phase actually looked
# like. Regenerate with scripts/render_examples.py — never hand-edit.
!renders/*.png
